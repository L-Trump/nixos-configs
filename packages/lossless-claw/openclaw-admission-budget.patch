 const serializedEstimateCache = new WeakMap<object, number>();
 
+const OPENCLAW_BASE_CHARS_PER_TOKEN = 4;
+const OPENCLAW_TOOL_RESULT_CHARS_PER_TOKEN = 2;
+const OPENCLAW_IMAGE_CHAR_ESTIMATE = 8_000;
+
+function estimateOpenClawUnknownChars(value: unknown): number {
+  if (typeof value === "string") {
+    return value.length;
+  }
+  if (value === undefined) {
+    return 0;
+  }
+  try {
+    return JSON.stringify(value)?.length ?? 0;
+  } catch {
+    return 256;
+  }
+}
+
+function estimateOpenClawToolResultContentChars(message: unknown): number {
+  if (!message || typeof message !== "object") {
+    return 0;
+  }
+  const record = message as { role?: unknown; type?: unknown; content?: unknown };
+  if (record.role !== "toolResult" && record.role !== "tool" && record.type !== "toolResult") {
+    return 0;
+  }
+  if (typeof record.content === "string") {
+    return record.content.length;
+  }
+  if (!Array.isArray(record.content)) {
+    return 0;
+  }
+  let chars = 0;
+  for (const block of record.content) {
+    if (block && typeof block === "object") {
+      const typed = block as { type?: unknown; text?: unknown };
+      if (typed.type === "text" && typeof typed.text === "string") {
+        chars += typed.text.length;
+        continue;
+      }
+      if (typed.type === "image") {
+        chars += OPENCLAW_IMAGE_CHAR_ESTIMATE;
+        continue;
+      }
+    }
+    chars += estimateOpenClawUnknownChars(block);
+  }
+  return chars;
+}
+
+function estimateOpenClawToolResultSurchargeTokens(message: unknown): number {
+  const chars = estimateOpenClawToolResultContentChars(message);
+  const surchargePerChar =
+    1 / OPENCLAW_TOOL_RESULT_CHARS_PER_TOKEN - 1 / OPENCLAW_BASE_CHARS_PER_TOKEN;
+  return Math.ceil(chars * surchargePerChar);
+}
