+++ b/.changeset/degraded-prompt-authority.md
@@ -0,0 +1,5 @@
+---
+"@martian-engineering/lossless-claw": patch
+---
+
+Keep OpenClaw's preemptive overflow check enabled when deferred compaction debt forces Lossless Claw to return a degraded live context that still exceeds its assembly budget. Safely bounded degraded output remains authoritative so the host does not recheck evicted pre-assembly history.
diff --git a/src/assemble-fallback.ts b/src/assemble-fallback.ts
index b6b676a..6f984ce 100644
--- a/src/assemble-fallback.ts
+++ b/src/assemble-fallback.ts
@@ -150,6 +150,18 @@ export function clampMessagesToSerializedBudget(params: {
   };
 }

+export function applyBudgetPromptAuthority(
+  result: AssembleResult,
+  tokenBudget: number,
+): AssembleResult {
+  const safeTokenBudget = Number.isFinite(tokenBudget)
+    ? Math.max(0, Math.floor(tokenBudget))
+    : 0;
+  return result.estimatedTokens > safeTokenBudget
+    ? { ...result, promptAuthority: "preassembly_may_overflow" }
+    : result;
+}
+
 export function isProtectedLeadingLiveContextMessage(message: AgentMessage): boolean {
   const role = typeof message.role === "string" ? message.role.toLowerCase() : "";
   return role === "system" || role === "developer";
@@ -159,6 +171,9 @@ export function buildDegradedLiveAssembleResult(params: {
   liveMessages: AgentMessage[];
   tokenBudget: number;
 }): AssembleResult {
+  const safeTokenBudget = Number.isFinite(params.tokenBudget)
+    ? Math.max(0, Math.floor(params.tokenBudget))
+    : 0;
   const withoutAssistantPrefill = stripTrailingAssistantPrefill(params.liveMessages.slice());
   const protectedPrefix: AgentMessage[] = [];
   while (
@@ -170,17 +185,19 @@ export function buildDegradedLiveAssembleResult(params: {
   const liveTail = withoutAssistantPrefill.slice(protectedPrefix.length);
   const remainingBudget = Math.max(
     0,
-    Math.floor(params.tokenBudget) - estimateAgentMessageTokens(protectedPrefix),
+    safeTokenBudget - estimateAgentMessageTokens(protectedPrefix),
   );
   let liveTailMessages = trimMessagesToBudget(liveTail, remainingBudget);
   if (liveTailMessages.length === 0 && liveTail.length > 0) {
     liveTailMessages = [liveTail[liveTail.length - 1]!];
   }
   const messages = [...protectedPrefix, ...liveTailMessages];
-  return {
-    messages,
-    estimatedTokens: estimateAgentMessageTokens(messages),
-  };
+  const estimatedTokens = estimateAgentMessageTokens(messages);
+  // Degraded assembly is still authoritative when its serialized output
+  // fits the declared budget. Ask OpenClaw to inspect the unwindowed
+  // pre-assembly transcript only when a mandatory protected/last message
+  // leaves the returned view itself over budget.
+  return applyBudgetPromptAuthority({ messages, estimatedTokens }, safeTokenBudget);
 }

 export function resolveDeferredAssemblyPressure(params: {
@@ -228,10 +245,13 @@ export function buildForkBoundedLiveFallback(params: {
     candidateMessages,
     Math.min(params.tokenBudget, params.bootstrapMaxTokens),
   );
-  return {
-    messages: boundedMessages,
-    estimatedTokens: estimateAgentMessageTokens(boundedMessages),
-  };
+  return applyBudgetPromptAuthority(
+    {
+      messages: boundedMessages,
+      estimatedTokens: estimateAgentMessageTokens(boundedMessages),
+    },
+    params.tokenBudget,
+  );
 }

 /** Return the log level for fork-bounded live suffix append pressure. */
